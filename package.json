{
  "name": "mihirkarbelkar",
  "description": "Mihir Karbelkar — production AI engineering, selected work and an open research lab.",
  "dependencies": {
    "@astrojs/cloudflare": "12.5.0",
    "@astrojs/mdx": "4.2.4",
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "4.0.11",
    "@astrojs/sitemap": "3.3.0",
    "@huggingface/transformers": "^3.7.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "5.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "wrangler": "4.12.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "cf-typegen": "wrangler types",
    "check": "astro check && tsc --noEmit",
    "deploy": "astro build && wrangler deploy",
    "dev": "ASTRO_ENV=DEV astro dev",
    "preview": "wrangler dev",
    "generate-favicons": "node scripts/generate-favicons.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dry-run": "wrangler deploy --dry-run",
    "format": "prettier --write src tests astro.config.mjs components.json wrangler.json"
  },
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.14.0"
  }
}
