---
import Icon from '../components/ui/Icon.astro';
import Sakura from '../components/fx/Sakura.astro';
import Layout from './Portfolio.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  domain?: 'tech' | 'politics' | 'fit' | 'puns';
  currentPage?: string;
  mood?: 'withering';
}
const { title, description, pubDate, updatedDate, heroImage, mood } =
  Astro.props;
---

<Layout title={`${title} — Mihir Karbelkar`} description={description}>
  {
    mood === 'withering' && (
      <>
        <Sakura fixed />
        <div class="wither-veil" aria-hidden="true" />
      </>
    )
  }
  <article class="wrap case-study" data-mood={mood}>
    <a class="back-link" href="/blog">
      <Icon name="left" /> All writing
    </a>
    <div class="section-label">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      {updatedDate && (
        <span>
          {' '}
          · Updated{' '}
          {updatedDate.toLocaleDateString('en-GB', { timeZone: 'UTC' })}
        </span>
      )}
    </div>
    <h1>{title}</h1>
    <p class="case-intro">{description}</p>
    {heroImage && (
      <img
        class="article-hero"
        src={heroImage}
        alt=""
        width="1020"
        height="510"
      />
    )}
    <div class="case-prose article-body">
      <slot />
    </div>
  </article>
</Layout>
<script>
  // mood: 'withering' — the branch ages as the reader scrolls (fx.css).
  if (document.querySelector('[data-mood="withering"]')) {
    const root = document.documentElement;
    root.classList.add('is-withering');
    let queued = false;
    const update = () => {
      queued = false;
      const max = root.scrollHeight - innerHeight;
      const p = max > 0 ? scrollY / max : 0;
      const decay = Math.min(1, Math.max(0, (p - 0.03) / 0.72));
      root.style.setProperty('--decay', decay.toFixed(3));
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
