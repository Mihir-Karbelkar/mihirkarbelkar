---
import Icon from '../components/ui/Icon.astro';
import Layout from './Portfolio.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  domain?: 'tech' | 'politics' | 'fit' | 'puns';
  currentPage?: string;
}
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout title={`${title} — Mihir Karbelkar`} description={description}>
  <article class="wrap case-study">
    <a class="back-link" href="/blog">
      <Icon name="left" /> All writing
    </a>
    <div class="section-label">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      {updatedDate && (
        <span>
          {' '}
          · Updated{' '}
          {updatedDate.toLocaleDateString('en-GB', { timeZone: 'UTC' })}
        </span>
      )}
    </div>
    <h1>{title}</h1>
    <p class="case-intro">{description}</p>
    {heroImage && (
      <img
        class="article-hero"
        src={heroImage}
        alt=""
        width="1020"
        height="510"
      />
    )}
    <div class="case-prose article-body">
      <slot />
    </div>
  </article>
</Layout>
