---
import Head from '../components/portfolio/Head.astro';
import Nav from '../components/portfolio/Nav.astro';
import Footer from '../components/portfolio/Footer.astro';
import ChatBar from '../components/chat/ChatBar';
import { projects, site } from '../data/portfolio';
const chat = {
  greeting: site.chat.greeting,
  placeholder: site.chat.placeholder,
  suggestions: site.chat.suggestions,
  sections: site.chat.sections,
  projects: projects.map(({ slug, title }) => ({ slug, title })),
};
interface Props {
  title?: string;
  description?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatBar client:only="react" {...chat} />
    <script>
      // Sections fade in as they enter the viewport (hidden only once JS runs).
      const sections = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-revealed');
              io.unobserve(e.target);
            }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        sections.forEach((s) => io.observe(s));
      } else sections.forEach((s) => s.classList.add('is-revealed'));
    </script>
  </body>
</html>
