---
import '../../styles/portfolio.css';
import { profile } from '../../data/portfolio';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Mihir Karbelkar — Software, models & notes',
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://mihirkarbelkar.com');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Mihir's writing"
  href="/rss.xml"
/>
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff"
  as="font"
  type="font/woff"
  crossorigin
/>
<meta name="theme-color" content="#F8F6F0" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta
  property="og:image"
  content="https://mihirkarbelkar.com/social-card.png"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta
  name="twitter:image"
  content="https://mihirkarbelkar.com/social-card.png"
/>
<script is:inline>
  try {
    document.documentElement.dataset.theme =
      localStorage.getItem('portfolio-theme') === 'dark' ? 'dark' : 'light';
  } catch {
    document.documentElement.dataset.theme = 'light';
  }
</script>
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    url: 'https://mihirkarbelkar.com',
    jobTitle: 'Software Engineer',
    homeLocation: { '@type': 'Place', name: 'Bengaluru, India' },
    sameAs: [profile.github, ...(profile.linkedin ? [profile.linkedin] : [])],
  })}
/>
