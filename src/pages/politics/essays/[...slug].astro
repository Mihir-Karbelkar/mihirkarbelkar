---
import Icon from '../../../components/ui/Icon.astro';
import Layout from '../../../layouts/Portfolio.astro';
import { getCollection, render } from 'astro:content';
export const prerender = true;
export async function getStaticPaths() {
  return (await getCollection('essays')).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Mihir Karbelkar`}
  description={post.data.description}
>
  <article class="section wrap case-study">
    <a class="back-link" href="/politics/essays">
      <Icon name="left" /> Essays
    </a>
    <h1>{post.data.title}</h1>
    <div class="case-prose article-body">
      <Content />
    </div>
  </article>
</Layout>
