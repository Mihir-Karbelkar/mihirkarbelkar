---
import Layout from '../layouts/Portfolio.astro';
import Icon from '../components/ui/Icon.astro';
import InterestArt from '../components/portfolio/InterestArt.astro';
import ProjectArtwork from '../components/portfolio/ProjectArtwork.astro';
import Sakura from '../components/fx/Sakura.astro';
import Mascot from '../components/fx/Mascot';
import Contact from '../components/portfolio/Contact';
import {
  profile,
  site,
  home,
  projects,
  featuredSlugs,
  archiveSlugs,
  notes,
  career,
  roleYears,
} from '../data/portfolio';
const { desk, work, archive: archiveCopy, about, contact, services } = home;
export const prerender = true;
const featured = featuredSlugs.map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const archive = archiveSlugs.map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const contactHref = '/book';
---

<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <Sakura />
    <div class="hero-copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 id="hero-title">
        {home.headline.map((sentence) => (
          <span>{sentence}</span>
        ))}
      </h1>
      <p class="hero-description">{home.body}</p>
      <div class="hero-actions">
        <a class="button primary" href={contactHref}>
          {home.contactAction}
          <Icon name="right" />
        </a>
        <a class="button text-button" href="#work">
          {home.primaryAction}
          <Icon name="down" />
        </a>
      </div>
      <p class="hero-supporting">{home.supporting}</p>
    </div>
    <aside class="desk" aria-labelledby="desk-title">
      <div class="desk-heading">
        <h2 id="desk-title">{desk.heading}</h2>
        <p>{desk.body}</p>
      </div>
      <div class="interest-tiles">
        {desk.items.map((i) => (
          <a class:list={['interest-tile', i.tone]} href={i.href}>
            <InterestArt kind={i.art} />
            <span class="tile-copy">
              <span class="tile-label">{i.label}</span>
              <span class="tile-title">{i.title}</span>
            </span>
            {i.href.startsWith('https:') && <Icon name="external" />}
          </a>
        ))}
      </div>
    </aside>
  </section>
  <section
    id="work"
    class="section wrap selected-work"
    data-reveal
    aria-labelledby="work-title"
  >
    <span id="projects" class="anchor-alias" aria-hidden="true"></span>
    <div class="section-heading">
      <div>
        <p class="eyebrow">{work.eyebrow}</p>
        <h2 id="work-title">{work.heading}</h2>
      </div>
      <p>{work.body}</p>
    </div>
    <div class="work-grid">
      {featured.map((p, i) => (
        <article
          id={`project-${p.slug}`}
          class:list={['work-card', `work-${i}`]}
        >
          <ProjectArtwork artwork={p.artwork} />
          <div class="work-card-copy">
            <p class="work-category">{p.category}</p>
            <h3>
              <a href={`/projects/${p.slug}`}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <a class="read-link" href={`/projects/${p.slug}`}>
              {work.readMore}
              <Icon name="right" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section
    id="services"
    class="section wrap services-section"
    data-reveal
    aria-labelledby="services-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id="services-title">{services.heading}</h2>
      </div>
      <p>{services.body}</p>
    </div>
    <ol class="services-grid">
      {services.items.map((item, i) => (
        <li class="service-card">
          <span class="note-number">0{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
    <a class="button primary services-cta" href="/book">
      {services.cta}
      <Icon name="right" />
    </a>
  </section>
  <section
    class="section wrap work-archive"
    data-reveal
    aria-labelledby="archive-title"
  >
    <div class="archive-intro">
      <p class="eyebrow">{archiveCopy.eyebrow}</p>
      <h2 id="archive-title">{archiveCopy.heading}</h2>
      <p>{archiveCopy.body}</p>
    </div>
    <div id="experience" class="archive-list">
      {archive.map((p) => (
        <article id={`project-${p.slug}`}>
          <div>
            <p class="work-category">{p.category}</p>
            <h3>
              <a href={`/projects/${p.slug}`}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
          </div>
          <a
            class="archive-open"
            href={`/projects/${p.slug}`}
            aria-label={`Read about ${p.title}`}
          >
            <Icon name="right" />
          </a>
        </article>
      ))}
    </div>
  </section>
  <section
    id="career"
    class="section wrap career-section"
    aria-labelledby="career-title"
    data-reveal
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{home.career.eyebrow}</p>
        <h2 id="career-title">{home.career.heading}</h2>
      </div>
      <a class="read-link" href="/about#career">
        {home.career.more}
        <Icon name="right" />
      </a>
    </div>
    <ol class="career-list">
      {career.roles.map((r) => (
        <li>
          <a href={`/about#${r.id}`}>
            <span class="career-company">{r.company}</span>
            <span class="career-role">
              {r.positions.map((pos) => pos.title).join(' · ')}
            </span>
            <span class="career-years">{roleYears(r)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <section
    id="notes"
    class="section notes-section"
    data-reveal
    aria-labelledby="notes-title"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.notes.eyebrow}</p>
          <h2 id="notes-title">{home.notes.heading}</h2>
        </div>
        <a class="read-link" href={home.notes.archiveHref}>
          {home.notes.archiveLabel}
          <Icon name="right" />
        </a>
      </div>
      <div class="notes-grid">
        {notes.map((note, i) => (
          <article class:list={['note-card', i === 0 ? 'sage' : 'blue']}>
            <span class="note-number">0{i + 1} / NOTES</span>
            <h3>
              <a href={note.href}>{note.title}</a>
            </h3>
            <p class="note-summary">{note.summary}</p>
            <p class="note-detail">{note.detail}</p>
            <a class="read-link" href={note.href}>
              {note.label}
              <Icon name={note.external ? 'external' : 'right'} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    id="about"
    class="section wrap about-section"
    data-reveal
    aria-labelledby="about-title"
  >
    <div>
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="about-title">{about.heading}</h2>
      <p class="about-location">{profile.location}</p>
    </div>
    <div class="about-copy">
      {about.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <div id="skills" class="about-tools">
        <p>{about.toolsLabel}</p>
        <ul>
          {about.tools.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
      <a class="read-link" href="/about">
        {about.more}
        <Icon name="right" />
      </a>
    </div>
  </section>
  <section
    id="contact"
    class="section wrap contact-section"
    data-reveal
    aria-labelledby="contact-title"
  >
    <div class="contact-copy">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contact-title">{contact.heading}</h2>
      <p>{contact.body}</p>
      <div class="contact-destinations">
        <a class="button primary" href="/book">
          {contact.calendar}
          <Icon name="right" />
        </a>
        <a class="button secondary" href={`mailto:${profile.email}`}>
          {contact.email}: {profile.email}
        </a>
        {profile.linkedin && (
          <a class="button secondary" href={profile.linkedin}>
            {contact.linkedin}
            <Icon name="external" />
          </a>
        )}
        <a class="button secondary" href={profile.huggingface}>
          {contact.huggingface}
          <Icon name="external" />
        </a>
        <a class="button secondary" href={profile.github}>
          {contact.github}
          <Icon name="external" />
        </a>
      </div>
    </div>
    <Contact
      client:visible
      email={profile.email}
      topics={services.items.map((i) => i.title).concat('Something else')}
    />
  </section>
  <Mascot client:idle steps={site.tour} />
</Layout>
