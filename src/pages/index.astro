---
import Layout from '../layouts/Portfolio.astro';
import Icon from '../components/ui/Icon.astro';
import InterestArt from '../components/portfolio/InterestArt.astro';
import ProjectArtwork from '../components/portfolio/ProjectArtwork.astro';
import {
  profile,
  home,
  projects,
  featuredSlugs,
  archiveSlugs,
  notes,
} from '../data/portfolio';
const { desk, work, archive: archiveCopy, about, contact } = home;
export const prerender = true;
const featured = featuredSlugs.map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const archive = archiveSlugs.map((slug) =>
  projects.find((p) => p.slug === slug)!,
);
const contactHref = profile.email
  ? `mailto:${profile.email}`
  : profile.linkedin || '#contact';
---

<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 id="hero-title">
        {home.headline.map((sentence) => (
          <span>{sentence}</span>
        ))}
      </h1>
      <p class="hero-description">{home.body}</p>
      <div class="hero-actions">
        <a class="button primary" href="#work">
          {home.primaryAction}
          <Icon name="down" />
        </a>
        <a class="button text-button" href={contactHref}>
          {home.contactAction}
        </a>
      </div>
      <p class="hero-supporting">{home.supporting}</p>
    </div>
    <aside class="desk" aria-labelledby="desk-title">
      <div class="desk-heading">
        <h2 id="desk-title">{desk.heading}</h2>
        <p>{desk.body}</p>
      </div>
      <div class="interest-tiles">
        {desk.items.map((i) => (
          <a class:list={['interest-tile', i.tone]} href={i.href}>
            <InterestArt kind={i.art} />
            <span class="tile-copy">
              <span class="tile-label">{i.label}</span>
              <span class="tile-title">{i.title}</span>
            </span>
            {i.href.startsWith('https:') && <Icon name="external" />}
          </a>
        ))}
      </div>
    </aside>
  </section>
  <section
    id="work"
    class="section wrap selected-work"
    aria-labelledby="work-title"
  >
    <span id="projects" class="anchor-alias" aria-hidden="true"></span>
    <div class="section-heading">
      <div>
        <p class="eyebrow">{work.eyebrow}</p>
        <h2 id="work-title">{work.heading}</h2>
      </div>
      <p>{work.body}</p>
    </div>
    <div class="work-grid">
      {featured.map((p, i) => (
        <article class:list={['work-card', `work-${i}`]}>
          <ProjectArtwork artwork={p.artwork} />
          <div class="work-card-copy">
            <p class="work-category">{p.category}</p>
            <h3>
              <a href={`/projects/${p.slug}`}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <a class="read-link" href={`/projects/${p.slug}`}>
              {work.readMore}
              <Icon name="right" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section wrap work-archive" aria-labelledby="archive-title">
    <div class="archive-intro">
      <p class="eyebrow">{archiveCopy.eyebrow}</p>
      <h2 id="archive-title">{archiveCopy.heading}</h2>
      <p>{archiveCopy.body}</p>
    </div>
    <div id="experience" class="archive-list">
      {archive.map((p) => (
        <article>
          <div>
            <p class="work-category">{p.category}</p>
            <h3>
              <a href={`/projects/${p.slug}`}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
          </div>
          <a
            class="archive-open"
            href={`/projects/${p.slug}`}
            aria-label={`Read about ${p.title}`}
          >
            <Icon name="right" />
          </a>
        </article>
      ))}
    </div>
  </section>
  <section
    id="notes"
    class="section notes-section"
    aria-labelledby="notes-title"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.notes.eyebrow}</p>
          <h2 id="notes-title">{home.notes.heading}</h2>
        </div>
        <a class="read-link" href={home.notes.archiveHref}>
          {home.notes.archiveLabel}
          <Icon name="right" />
        </a>
      </div>
      <div class="notes-grid">
        {notes.map((note, i) => (
          <article class:list={['note-card', i === 0 ? 'sage' : 'blue']}>
            <span class="note-number">0{i + 1} / NOTES</span>
            <h3>
              <a href={note.href}>{note.title}</a>
            </h3>
            <p class="note-summary">{note.summary}</p>
            <p class="note-detail">{note.detail}</p>
            <a class="read-link" href={note.href}>
              {note.label}
              <Icon name="external" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    id="about"
    class="section wrap about-section"
    aria-labelledby="about-title"
  >
    <div>
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="about-title">{about.heading}</h2>
      <p class="about-location">{profile.location}</p>
    </div>
    <div class="about-copy">
      {about.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <div id="skills" class="about-tools">
        <span id="services" class="anchor-alias" aria-hidden="true"></span>
        <p>{about.toolsLabel}</p>
        <ul>
          {about.tools.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
      <a class="read-link" href="/about">
        {about.more}
        <Icon name="right" />
      </a>
    </div>
  </section>
  <section
    id="contact"
    class="section wrap contact-section"
    aria-labelledby="contact-title"
  >
    <div>
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contact-title">{contact.heading}</h2>
      <p>{contact.body}</p>
    </div>
    <div class="contact-destinations">
      {profile.email && (
        <a class="button primary" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      )}
      {profile.linkedin && (
        <a class="button secondary" href={profile.linkedin}>
          {contact.linkedin}
          <Icon name="external" />
        </a>
      )}
      <a
        class:list={['button', profile.email ? 'secondary' : 'primary']}
        href={profile.github}
      >
        {contact.github}
        <Icon name="external" />
      </a>
      {profile.calendar && (
        <a class="read-link" href={profile.calendar}>
          {contact.calendar}
          <Icon name="external" />
        </a>
      )}
    </div>
  </section>
</Layout>
