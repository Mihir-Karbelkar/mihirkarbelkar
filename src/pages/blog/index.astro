---
import Icon from '../../components/ui/Icon.astro';
import Layout from '../../layouts/Portfolio.astro';
import { getCollection } from 'astro:content';
export const prerender = true;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Writing — Mihir Karbelkar">
  <section class="section wrap case-study">
    <div class="section-label">NOTES & WRITING</div>
    <h1>
      A place for
      <br />
      <span class="serif-word">thinking out loud.</span>
    </h1>
    <p class="case-intro">
      AI, engineering and the systems around us. Notes from the existing
      archive.
    </p>
    <div class="expertise-pills" role="group" aria-label="Filter writing">
      <button
        class="button secondary small"
        data-category="all"
        aria-pressed="true"
      >
        All
      </button>
      {['tech', 'politics', 'puns'].map((c) => (
        <button
          class="button secondary small"
          data-category={c}
          aria-pressed="false"
        >
          {c}
        </button>
      ))}
    </div>
    <div class="writing-grid">
      {posts.map((p) => (
        <article class="writing-card" data-post-category={p.data.category}>
          <a href={`/blog/${p.id}/`}>
            {p.data.heroImage && (
              <img
                src={p.data.heroImage}
                alt=""
                width="720"
                height="360"
                loading="lazy"
              />
            )}
            <div>
              <span class="section-label">
                {p.data.category} /{' '}
                <time datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="case-link">
                Read note <Icon name="right" />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
<script>
  const filters =
    document.querySelectorAll<HTMLButtonElement>('[data-category]');
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      filters.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button)),
      );
      document
        .querySelectorAll<HTMLElement>('[data-post-category]')
        .forEach((post) => {
          post.hidden =
            button.dataset.category !== 'all' &&
            post.dataset.postCategory !== button.dataset.category;
        });
    }),
  );
</script>
