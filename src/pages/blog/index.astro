---
import Icon from '../../components/ui/Icon.astro';
import Layout from '../../layouts/Portfolio.astro';
import { getCollection } from 'astro:content';
export const prerender = true;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Writing — Mihir Karbelkar">
  <section class="section wrap case-study">
    <div class="section-label">NOTES & WRITING</div>
    <h1>
      A place for
      <br />
      <span class="serif-word">thinking out loud.</span>
    </h1>
    <p class="case-intro">
      Notes from fine-tuning and training models, and the engineering around
      them.
    </p>
    <div class="writing-grid">
      {posts.map((p) => (
        <article class="writing-card">
          <a href={`/blog/${p.id}/`}>
            {p.data.heroImage && (
              <img
                src={p.data.heroImage}
                alt=""
                width="720"
                height="360"
                loading="lazy"
              />
            )}
            <div>
              <span class="section-label">
                {p.data.category} /{' '}
                <time datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="case-link">
                Read note <Icon name="right" />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
