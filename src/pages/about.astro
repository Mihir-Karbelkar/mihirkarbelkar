---
import Layout from '../layouts/Portfolio.astro';
import Icon from '../components/ui/Icon.astro';
import {
  career,
  formatMonth,
  home,
  profile,
  site,
  skills,
} from '../data/portfolio';
const page = site.aboutPage;
export const prerender = true;
---

<Layout title={page.title}>
  <article class="section wrap case-study">
    <a class="back-link" href="/#about">
      <Icon name="left" />
      {page.backLabel}
    </a>
    <p class="eyebrow">About / {profile.location}</p>
    <h1>{page.heading}</h1>
    <div class="case-prose about-page">
      {home.about.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <h2>{page.backgroundHeading}</h2>
      {page.background.map((p) => (
        <p>{p}</p>
      ))}
      <h2 id="career">{page.careerHeading}</h2>
      <ol class="timeline">
        {career.roles.map((r) => (
          <li id={r.id}>
            <h3>
              {r.company}
              {r.location && <span class="timeline-place">{r.location}</span>}
            </h3>
            {r.positions.map((pos) => (
              <p class="timeline-role">
                <strong>{pos.title}</strong>
                <span>
                  {formatMonth(pos.start)} – {formatMonth(pos.end)}
                </span>
              </p>
            ))}
            {r.highlights.length > 0 && (
              <ul>
                {r.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
      <h2 id="education">{page.educationHeading}</h2>
      {career.education.map((e) => (
        <p class="timeline-role">
          <strong>
            {e.degree}, {e.school}
          </strong>
          <span>
            {e.start} – {e.end}
          </span>
        </p>
      ))}
      <h3 class="certifications-heading">{page.certificationsHeading}</h3>
      <ul class="certifications">
        {career.certifications.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
      <h2>{page.toolsHeading}</h2>
      <dl class="background-tools">
        {skills.map(({ label, items }) => (
          <div>
            <dt>{label}</dt>
            <dd>{items}</dd>
          </div>
        ))}
      </dl>
      <a class="button primary" href="/#work">
        {page.action}
        <Icon name="down" />
      </a>
    </div>
  </article>
</Layout>
