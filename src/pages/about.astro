---
import Layout from '../layouts/Portfolio.astro';
import Icon from '../components/ui/Icon.astro';
import { home, profile, skills } from '../data/portfolio';
export const prerender = true;
---

<Layout title="About — Mihir Karbelkar">
  <article class="section wrap case-study">
    <a class="back-link" href="/#about">
      <Icon name="left" />
      Back to the site
    </a>
    <p class="eyebrow">About / {profile.location}</p>
    <h1>I’m Mihir.</h1>
    <div class="case-prose about-page">
      {home.about.map((p) => (
        <p>{p}</p>
      ))}
      <h2>Some of my background</h2>
      <p>
        I’ve worked with React and TypeScript, on frontend performance, and on
        backend platforms. At Ati Motors, I worked on scaling a robot fleet
        platform. In payments engineering, my work included high-traffic product
        surfaces and frontend bundle reductions.
      </p>
      <p>
        My AI work includes research tools for public markets, retrieval
        workflows and experiments with model learning. I keep the project pages
        separate so I can describe the actual work and its limits.
      </p>
      <h2>Tools I’ve worked with</h2>
      <dl class="background-tools">
        {skills.map(([label, items]) => (
          <div>
            <dt>{label}</dt>
            <dd>{items}</dd>
          </div>
        ))}
      </dl>
      <a class="button primary" href="/#work">
        See my work
        <Icon name="down" />
      </a>
    </div>
  </article>
</Layout>
